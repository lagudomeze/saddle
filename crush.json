{
  "$schema": "https://charm.land/crush.json",
  "permissions": {
    "allowed_tools": [
      "view",
      "ls",
      "grep",
      "edit",
      "minmax",
      "write",
      "multiedit",
      "bash",
      "agentic_fetch",
      "mcp_context7_get-library-doc"
    ]
  },
  "options": {
    "data_directory": ".crush",
    "skills_paths": [".crush/skill"],
    "initialize_as": "AGENTS.md",
    "auto_lsp": true,
    "progress": true
  },
  "tools": {
    "ls": {
      "max_depth": 10,
      "max_items": 1000
    },
    "grep": {
      "timeout": 30
    }
  },
  "mcp": {
    "minmax-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": ["minimax-coding-plan-mcp"],
      "env": {
        "MINIMAX_API_KEY": "sk-cp-z_3TZs_D0cj94ItOFXqHHm2CsQJZhdliEdaKDxOLLkJyFbEpztvw0DnMs9HAnTrrrpeBPXx4KImqP25UnWqtIuVCJAgkenK9wCv6lFuDZmmV3mSyZRjSKv8",
        "MINIMAX_MCP_BASE_PATH": ".minmax",
        "MINIMAX_API_HOST": "https://api.minimaxi.com",
        "MINIMAX_API_RESOURCE_MODE": "url"
      }
    }
  }
}
